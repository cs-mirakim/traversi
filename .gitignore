# ==============================================================================
# TRAVERSI - .gitignore
# Audit & Hardened to protect confidential credentials, keys, envs, & local artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Confidential Secret Files (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
*.env
*.env.*
!.env.example
!.env.sample
!.env.template

# Secrets, credentials & service accounts
*.secret
*.secrets
secrets.json
credentials.json
serviceAccountKey.json
*service-account*.json
*credentials*.json
client_secret*.json
firebase-adminsdk*.json

# SSL / TLS / Cryptographic Keys & Certificates
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.der
*.keystore
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pubkey

# Auth / Session tokens
auth_token*
*.token

# ------------------------------------------------------------------------------
# 2. Database Files & Backups (Local DB & SQL Dumps)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db3
*.s3db
*.dump
*.sql.gz
*dump*.sql
*backup*.sql
*.backup
*.bak

# ------------------------------------------------------------------------------
# 3. Next.js, Bundlers & Build Artifacts
# ------------------------------------------------------------------------------
/.next/
/out/
/build
/dist
/.turbo
/.cache
.eslintcache
*.tsbuildinfo
next-env.d.ts

# Vercel & Cloud deployment
.vercel
.serverless/

# ------------------------------------------------------------------------------
# 4. Dependencies & Package Managers
# ------------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store

# ------------------------------------------------------------------------------
# 5. Testing & Code Coverage
# ------------------------------------------------------------------------------
/coverage
*.lcov
.nyc_output

# ------------------------------------------------------------------------------
# 6. Logs & Debugging
# ------------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 7. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 8. IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json.example

# ------------------------------------------------------------------------------
# 9. Temporary & Scratch Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
scratch/
