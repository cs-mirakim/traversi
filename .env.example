# Environment Variables Template for Traversi
# Salin fail ini ke .env.local: cp .env.example .env.local

# 1. Supabase (Database & Cache) - Free Tier 500MB
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Google Gemini 1.5 Flash (AI Estimates & Itinerary) - Free 15 RPM / 1500 RPD
GEMINI_API_KEY=your-gemini-api-key-here

# 3. Amadeus Flight API (Free Test Env 2000 calls/month)
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret
AMADEUS_ENV=test
